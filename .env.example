# 采集间隔（秒）。测量阶段 300 足够；要看机会窗口持续多久可以降到 60。
POLL_SEC=300

# ---- 访问方式 ----
# 默认只绑回环，走 SSH 隧道最安全：
#   BIND=127.0.0.1
#   PORT=8080
# 想直接用浏览器打服务器 IP，改成下面这样：
BIND=0.0.0.0
PORT=80

# ---- 口令保护 ----
# BIND=0.0.0.0 时必须设置。留空 = 任何人都能打开这个页面。
# 注意：走 http（非 https）时 Basic Auth 的口令是明文传输的，
# 所以安全组里仍应把来源限制为你的固定 IP，别用 0.0.0.0/0。
AUTH_USER=mian
AUTH_PASS=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 容器内数据库路径，一般不用改
DB_PATH=/data/radar.db
